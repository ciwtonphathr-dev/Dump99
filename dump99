local function tween(obj, props, duration, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(duration or 0.25, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function pulseStroke(stroke)
    if pulseConn then pulseConn:Disconnect() end
    local t = 0
    pulseConn = RunService.RenderStepped:Connect(function(dt)
        t = t + dt
        stroke.Transparency = 0.35 + math.sin(t * 4) * 0.25
    end)
end

local function stopPulse()
    if pulseConn then pulseConn:Disconnect() pulseConn = nil end
    MainStroke.Transparency = 0.35
end

local function updateStatus(text) StatusText.Text = text end
local function addLog(msg)
    local lines = {}
    for line in string.gmatch(LogText.Text .. "\n• " .. tostring(msg), "[^\n]+") do
        table.insert(lines, line)
    end
    while #lines > 12 do table.remove(lines, 1) end
    LogText.Text = table.concat(lines, "\n")
end

