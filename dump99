local function safeButtonAnim(btn, normal, hover)
    local originalSize = btn.Size
    btn.MouseEnter:Connect(function()
        if btn.Active ~= false then tween(btn, {BackgroundColor3 = hover}, 0.18) end
    end)
    btn.MouseLeave:Connect(function()
        if btn.Active ~= false then tween(btn, {BackgroundColor3 = normal}, 0.18) end
    end)
    btn.MouseButton1Down:Connect(function()
        tween(btn, {Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset - 4, originalSize.Y.Scale, originalSize.Y.Offset - 3)}, 0.08)
    end)
    btn.MouseButton1Up:Connect(function()
        tween(btn, {Size = originalSize}, 0.12)
    end)
end

