    end
end

local function sanitizeName(name)
    name = tostring(name or "unnamed")
    name = name:gsub("[\\/:*?\"<>|]", "_")
    name = name:gsub("%s+", " ")
    if #name > 80 then name = name:sub(1, 80) end
    if name == "" or name == "." or name == ".." then name = "unnamed" end
    return name
end

local function ensureDir(path)
    if not makefolder then return end
    local parts = {}
    for part in string.gmatch(path, "[^/]+") do
        table.insert(parts, part)
        pcall(makefolder, table.concat(parts, "/"))
    end
end

local function queueWrite(relPath, content)
    table.insert(pendingWrites, {path = dumpRoot .. "/" .. relPath, content = content or ""})
    fileCount = fileCount + 1
end

local function getScriptSource(obj)
    local src = nil
    local ok, res = pcall(function()
        if decompile then return decompile(obj) end
        return nil
    end)
    if ok and type(res) == "string" and #res > 0 then
        src = res
    else
        local ok2, res2 = pcall(function() return obj.Source end)
        if ok2 and type(res2) == "string" and #res2 > 0 then
            src = res2
        end
    end
    return src
end

local function relativeUnderService(obj, serviceName, serviceInstance)
    local full = obj:GetFullName()
    local pattern = "^game%." .. serviceName .. "%.?"
    local rel = full:gsub(pattern, "")
    if rel == full then
        pattern = "^" .. serviceName .. "%.?"
        rel = full:gsub(pattern, "")
    end
    if rel == "" or rel == full then
        return sanitizeName(obj.Name)
    end
    local parts = {}
    for part in string.gmatch(rel, "[^%.]+") do
        table.insert(parts, sanitizeName(part))
    end
    return table.concat(parts, "/")
end

local function pathForScript(obj, serviceName)
    local rel = relativeUnderService(obj, serviceName)
    return serviceName .. "/" .. rel .. ".lua"
end

local function pathForRemote(obj, serviceName)
    local rel = relativeUnderService(obj, serviceName)
    return "Remote/" .. serviceName .. "/" .. rel .. ".remote.txt"
end

local function extractScriptFile(obj, serviceName)
    scriptCount = scriptCount + 1
    local src = getScriptSource(obj)
    if not src then
        src = "-- [Unable to extract source / protected]\n-- Class: " .. obj.ClassName .. "\n-- Path: " .. obj:GetFullName() .. "\n"
    end
    local path = pathForScript(obj, serviceName)
    queueWrite(path, src)
end

local function extractRemoteFile(obj, serviceName)
    remoteCount = remoteCount + 1
    local parentName = obj.Parent and obj.Parent:GetFullName() or "nil"
    local body = table.concat({
        "ClassName: " .. obj.ClassName,
        "Name: " .. obj.Name,
        "Path: " .. obj:GetFullName(),
        "Parent: " .. parentName,
    }, "\n")
    queueWrite(pathForRemote(obj, serviceName), body)
end

local function deepWalk(obj, serviceName)
    if not obj then return end
    if ignoreNames[obj.Name] then return end

    local classOk = true
    pcall(function()
        if obj:IsA("LocalScript") or obj:IsA("ModuleScript") or obj:IsA("Script") then
            extractScriptFile(obj, serviceName)
        elseif obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("BindableEvent") or obj:IsA("BindableFunction") then
            extractRemoteFile(obj, serviceName)
        elseif obj:IsA("ValueBase") then
            valueCount = valueCount + 1
        elseif obj:IsA("Humanoid") then
            humanoidCount = humanoidCount + 1
        end
    end)

    local total = scriptCount + remoteCount
    if total > 0 and total % 4 == 0 then
        updateStatus(string.format("Scanning...\nS:%d R:%d Files:%d", scriptCount, remoteCount, fileCount))
        task.wait(0.02)
    end

    local ok, children = pcall(function() return obj:GetChildren() end)
    if not ok or not children then return end
    for i, child in ipairs(children) do
        deepWalk(child, serviceName)
        if i % 6 == 0 then
            task.wait()
        end
    end
end

local function buildDumpRootName()
    local placeName = "Game"
    pcall(function()
        placeName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
    end)
    placeName = sanitizeName(placeName)
    return string.format("%s/%s [%d]", FOLDER_NAME, placeName, game.PlaceId)
end

local function startScan()
    if isScanning then return end
    if not writefile or not makefolder then
        updateStatus("ERROR\nNeed writefile + makefolder")
        addLog("Executor missing writefile/makefolder")
        return
    end

    isScanning = true
    scriptCount, remoteCount, valueCount, humanoidCount = 0, 0, 0, 0
    attrCount, otherCount, moduleReturnCount, fileCount = 0, 0, 0, 0
    pendingWrites = {}
    summaryLines = {}
    canDump = false
    setDumpEnabled(false)

    dumpRoot = buildDumpRootName()
    pcall(makefolder, FOLDER_NAME)
    ensureDir(dumpRoot)

    ScanBtn.Text = "SCANNING..."
    tween(ScanBtn, {BackgroundColor3 = Color3.fromRGB(60, 60, 75)}, 0.2)
    LogText.Text = "• Scan started"
    updateStatus("Phase 1\nBuilding tree...")
    setProgress(true, 0.05)
    pulseStroke(MainStroke)

    task.spawn(function()
        local targets = {
            {game:GetService("ReplicatedStorage"), "ReplicatedStorage"},
            {game:GetService("ReplicatedFirst"), "ReplicatedFirst"},
            {game:GetService("StarterPlayer"), "StarterPlayer"},
            {game:GetService("StarterGui"), "StarterGui"},
            {game:GetService("StarterPack"), "StarterPack"},
            {LocalPlayer:FindFirstChild("PlayerGui"), "LocalPlayer/PlayerGui"},
            {LocalPlayer:FindFirstChild("PlayerScripts"), "LocalPlayer/PlayerScripts"},
            {LocalPlayer:FindFirstChild("Backpack"), "LocalPlayer/Backpack"},
            {LocalPlayer.Character, "LocalPlayer/Character"},
            {workspace, "Workspace"},
            {game:GetService("Players"), "Players"},
            {game:GetService("Lighting"), "Lighting"},
            {game:GetService("SoundService"), "SoundService"},
            {game:GetService("Chat"), "Chat"},
            {game:GetService("TextChatService"), "TextChatService"},
            {game:GetService("Teams"), "Teams"},
        }

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                table.insert(targets, {plr.Character, "Workspace/" .. sanitizeName(plr.Name)})
            end
        end

        local total = #targets
        for i, data in ipairs(targets) do
            local obj, name = data[1], data[2]
            if obj then
                updateStatus(string.format("Scan %d/%d\n%s", i, total, name))
                addLog(name)
                setProgress(true, 0.05 + (i / total) * 0.75)
                local serviceKey = name:match("^([^/]+)") or name
                pcall(deepWalk, obj, serviceKey)
            end
            task.wait(0.04)
        end

        local summary = {
            "EGO HUB HIERARCHICAL DUMP",
            "PlaceId: " .. tostring(game.PlaceId),
            "Generated: " .. os.date("%Y-%m-%d %H:%M:%S"),
            "Scripts: " .. scriptCount,
            "Remotes: " .. remoteCount,
            "Files queued: " .. fileCount,
            "Values seen: " .. valueCount,
            "Humanoids: " .. humanoidCount,
            "",
            "Structure mirrors game tree:",
            "  <Place>/ReplicatedStorage/.../*.lua",
            "  <Place>/LocalPlayer/PlayerScripts/.../*.lua",
            "  <Place>/Remote/<Service>/.../*.remote.txt",
            "",
            "Press DUMP to write all files to executor workspace.",
        }
        queueWrite("_SUMMARY.txt", table.concat(summary, "\n"))

        isScanning = false
        ScanBtn.Text = "SCAN"
        tween(ScanBtn, {BackgroundColor3 = Color3.fromRGB(55, 115, 255)}, 0.25)
        setDumpEnabled(true)
        setProgress(true, 1)
        stopPulse()
        task.wait(0.25)
        setProgress(false, 0)

        updateStatus(string.format("Done!\nS:%d R:%d F:%d", scriptCount, remoteCount, fileCount))
        addLog(string.format("Ready dump S:%d R:%d", scriptCount, remoteCount))
    end)
end

local function doDump()
    if not canDump or #pendingWrites == 0 then return end
    if not writefile then
        updateStatus("ERROR\nNo writefile")
        return
    end

    DumpBtn.Text = "WRITING..."
    DumpBtn.Active = false
    updateStatus("Writing files...\n0 / " .. #pendingWrites)
    addLog("Writing " .. #pendingWrites .. " files")

    task.spawn(function()
        local total = #pendingWrites
        local written = 0
        for i, item in ipairs(pendingWrites) do
            local dir = item.path:match("(.+)/[^/]+$")
            if dir then ensureDir(dir) end
            pcall(writefile, item.path, item.content)
            written = written + 1
            if i % 5 == 0 or i == total then
                updateStatus(string.format("Writing...\n%d / %d", written, total))
                setProgress(true, written / total)
                task.wait()
            end
        end

        setProgress(false, 0)
        DumpBtn.Text = "DUMP"
        DumpBtn.Active = true
        updateStatus("SUCCESS!\n" .. dumpRoot)
        addLog("Saved → " .. dumpRoot)
        tween(MainStroke, {Color = Color3.fromRGB(40, 200, 100)}, 0.2)
        task.delay(1.2, function()
            tween(MainStroke, {Color = Color3.fromRGB(55, 90, 180)}, 0.4)
        end)
    end)
end

local function safeButtonAnim(btn, normal, hover)
    local originalSize = btn.Size
    btn.MouseEnter:Connect(function()
        if btn.Active ~= false then tween(btn, {BackgroundColor3 = hover}, 0.18) end
    end)
    btn.MouseLeave:Connect(function()
        if btn.Active ~= false then tween(btn, {BackgroundColor3 = normal}, 0.18) end
    end)
    btn.MouseButton1Down:Connect(function()
        tween(btn, {Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset - 4, originalSize.Y.Scale, originalSize.Y.Offset - 3)}, 0.08)
    end)
    btn.MouseButton1Up:Connect(function()
        tween(btn, {Size = originalSize}, 0.12)
    end)
end

