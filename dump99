-- 4. DETECT REMOTE SPAM (ปรับจำนวนสูงขึ้น)
-- ===================================================================================
local OldFireServer
OldFireServer = hookmetamethod(game, "__namecall", function(Self, ...)
    local Method = getnamecallmethod()
    if not checkcaller() and Method == "FireServer" then
        local Key = tostring(Self) .. "_" .. tostring(...)
        AntiCheat.Flags[Key] = (AntiCheat.Flags[Key] or 0) + 1
        if AntiCheat.Flags[Key] > 200 then
            AntiCheat:AddViolation(LocalPlayer, "RemoteSpam", "Sent " .. AntiCheat.Flags[Key] .. " events")
            AntiCheat.Flags[Key] = 0
        end
    end
    return OldFireServer(Self, ...)
end)

-- ===================================================================================
-- 5. DETECT ESP (ข้าม UI ของตัวเอง)
-- ===================================================================================
local function CheckESP()
    if not AntiCheat.Enabled then return end
    local CoreGui = game:GetService("CoreGui")
    for _, Obj in ipairs(CoreGui:GetDescendants()) do
        if Obj:IsA("Highlight") or Obj:IsA("SelectionBox") then
            if not IsPartWhitelisted(Obj) then
                AntiCheat:AddViolation(LocalPlayer, "ESP", "Found: " .. Obj.Name)
            end
        end
    end
end

-- ===================================================================================
-- 6. DETECT ITEM DUPE
-- ===================================================================================
local function CheckDupe()
    if not AntiCheat.Enabled then return end
    local Inventory = LocalPlayer:FindFirstChild("Backpack") or LocalPlayer:FindFirstChild("StarterPack")
    if not Inventory then return end
    local Items = {}
    for _, Item in ipairs(Inventory:GetChildren()) do
        if Item:IsA("Tool") then
            Items[Item.Name] = (Items[Item.Name] or 0) + 1
            if Items[Item.Name] > 1 then
                AntiCheat:AddViolation(LocalPlayer, "ItemDupe", "Duplicated: " .. Item.Name)
            end
        end
    end
end

-- ===================================================================================
-- 7. DETECT CHAT COMMAND ABUSE
-- ===================================================================================
local function CheckChatSpam()
    if not AntiCheat.Enabled then return end
    local Chat = game:GetService("Chat")
    if not Chat then return end
    for _, Msg in ipairs(Chat:GetDescendants()) do
        if Msg:IsA("TextChatMessage") and (Msg.Text:match("^/") or Msg.Text:match("^!")) then
            AntiCheat:AddViolation(LocalPlayer, "CommandAbuse", "Cmd: " .. Msg.Text)
        end
    end
end

-- ===================================================================================
-- ANTI-CHEAT VIOLATION HANDLER (ไม่แบนตัวเอง)
-- ===================================================================================
function AntiCheat:AddViolation(Player, Type, Details)
    if not self.Enabled then return end
    if self.WhitelistedPlayers[Player.UserId] then return end
    if Player == LocalPlayer then return end

    local Key = Player.UserId .. "_" .. Type
    self.Violations[Key] = (self.Violations[Key] or 0) + 1

    if self.Violations[Key] >= self.BanThreshold then
        self:BanPlayer(Player, Type, Details)
    end
end

function AntiCheat:BanPlayer(Player, Type, Details)
    local Msg = "[AC] " .. Player.Name .. " banned: " .. Type .. " | " .. Details
    print(Msg)
    if self.WebhookURL then
        pcall(function()
            game:GetService("HttpService"):PostAsync(self.WebhookURL, 
                game:GetService("HttpService"):JSONEncode({content = Msg}),
                Enum.HttpContentType.ApplicationJson)
        end)
    end
    Player:Kick("Banned: " .. Type)
end

