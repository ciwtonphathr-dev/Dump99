local function getViewport()
    local cam = workspace.CurrentCamera
    return (cam and cam.ViewportSize) or Vector2.new(1280, 720)
end

local function getDeviceKind()
    local vp = getViewport()
    local shortest = math.min(vp.X, vp.Y)
    local portrait = vp.Y > vp.X
    local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    if shortest <= 500 or (touch and portrait) then
        return "phone"
    elseif shortest <= 900 then
        return "tablet"
    end
    return "desktop"
end

local function getResponsiveSize()
    local vp = getViewport()
    local kind = getDeviceKind()
    local width, height
    if kind == "phone" then
        if vp.Y > vp.X then
            width  = math.clamp(math.floor(vp.X * 0.71), 230, 320)
            height = math.clamp(math.floor(vp.Y * 0.48), 300, 420)
        else
            width  = math.clamp(math.floor(vp.X * 0.42), 280, 400)
            height = math.clamp(math.floor(vp.Y * 0.75), 250, 350)
        end
    elseif kind == "tablet" then
        if vp.Y > vp.X then
            width  = math.clamp(math.floor(vp.X * 0.58), 340, 460)
            height = math.clamp(math.floor(vp.Y * 0.46), 380, 520)
        else
            width  = math.clamp(math.floor(vp.X * 0.38), 360, 480)
            height = math.clamp(math.floor(vp.Y * 0.62), 380, 560)
        end
    else
        width  = math.clamp(math.floor(vp.X * 0.32), 360, 460)
        height = math.clamp(math.floor(vp.Y * 0.58), 420, 580)
    end
    return UDim2.fromOffset(width, height)
end

local function getLayoutMetrics()
    local kind = getDeviceKind()
    if kind == "phone" then
