local function getViewport()
    local cam = workspace.CurrentCamera
    return (cam and cam.ViewportSize) or Vector2.new(1920, 1080)
end

local function getResponsiveSize()
    local vp = getViewport()
    local w = math.clamp(vp.X * 0.75, 340, 600)
    local h = w * 1.35
    return UDim2.new(0, w, 0, h)
end

local function getLayoutMetrics()
    local vp = getViewport()
    local w = vp.X
    local isPhone = w < 600
    return {
        titleH = isPhone and 48 or 56,
        logo = isPhone and 30 or 34,
        titleText = isPhone and 15 or 17,
        subtitleText = isPhone and 10 or 11,
        minBtn = isPhone and 28 or 30,
        minText = isPhone and 18 or 20,
        pad = isPhone and 10 or 14,
        statusH = isPhone and 68 or 76,
        statusTitle = isPhone and 9 or 10,
        statusText = isPhone and 12 or 13,
        btnH = isPhone and 38 or 44,
        btnText = isPhone and 11 or 13,
