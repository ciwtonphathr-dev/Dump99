-- ===================================================================================
-- ฟังก์ชันตรวจสอบว่า Part อยู่ใน Whitelist หรือไม่
-- ===================================================================================
local function IsPartWhitelisted(Part)
    for _, Name in ipairs(AntiCheat.WhitelistedPartNames) do
        if Part.Name == Name or Part.Name:find(Name) then
            return true
        end
    end
    local Parent = Part.Parent
    while Parent do
        for _, Name in ipairs(AntiCheat.WhitelistedParents) do
            if Parent.Name == Name or Parent.Name:find(Name) then
                return true
            end
        end
        Parent = Parent.Parent
    end
    return false
end

-- ===================================================================================
-- 1. DETECT NOCLIP (ข้าม Parts ใน Whitelist)
-- ===================================================================================
local function CheckNoclip()
    if not AntiCheat.Enabled then return end
    local Char = LocalPlayer.Character
    if not Char then return end

    for _, Part in ipairs(Char:GetDescendants()) do
        if Part:IsA("BasePart") and Part.CanCollide == false then
            if not IsPartWhitelisted(Part) then
                AntiCheat:AddViolation(LocalPlayer, "Noclip", "Part: " .. Part.Name)
            end
        end
    end
end

-- ===================================================================================
-- 2. DETECT SPEED HACK (ปรับค่าสูงขึ้น)
-- ===================================================================================
local function CheckMovement()
    if not AntiCheat.Enabled then return end
    local Char = LocalPlayer.Character
    if not Char then return end
    local Hum = Char:FindFirstChild("Humanoid")
    if not Hum then return end

    if Hum.WalkSpeed > 50 then
        AntiCheat:AddViolation(LocalPlayer, "SpeedHack", "WalkSpeed: " .. Hum.WalkSpeed)
    end

    if Hum.JumpPower > 100 then
        AntiCheat:AddViolation(LocalPlayer, "InfiniteJump", "JumpPower: " .. Hum.JumpPower)
    end
end

-- ===================================================================================
-- 3. DETECT TELEPORT (ปรับระยะไกลขึ้น)
-- ===================================================================================
local LastPos = Vector3.new(0, 0, 0)
local function CheckTeleport()
    if not AntiCheat.Enabled then return end
    local Char = LocalPlayer.Character
    if not Char then return end
    local Root = Char:FindFirstChild("HumanoidRootPart")
    if not Root then return end

    local Dist = (Root.Position - LastPos).Magnitude
    if Dist > 300 and LastPos ~= Vector3.new(0, 0, 0) then
        AntiCheat:AddViolation(LocalPlayer, "Teleport", "Moved " .. Dist .. " studs")
    end
    LastPos = Root.Position
end

